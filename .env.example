# WL Sales — пример окружения
# Скопируйте в .env и заполните. Файл .env НЕ коммитить.

APP_NAME="WL Sales"
APP_URL=https://wlsales.1tlt.ru
APP_ENV=production
APP_DEBUG=0
APP_KEY=change-me-to-random-32-chars-min!!

APP_TIMEZONE=Europe/Moscow

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wlsales
DB_USER=wlsales
DB_PASS=change_me_db_password

ADMIN_EMAIL=admin@wlsales.1tlt.ru
ADMIN_PASSWORD=ChangeMeAdmin2026!

MAIL_DRIVER=mail
MAIL_FROM=noreply@wlsales.1tlt.ru
MAIL_FROM_NAME="WL Sales"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=tls

# --- Платежи (как в fullvpnservice): пусто = способ скрыт ---

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://wlsales.1tlt.ru/account/orders

# FreeKassa (СБП / карты РФ / world USD — три метода при одном ключе)
FREEKASSA_SHOP_ID=
FREEKASSA_API_KEY=
FREEKASSA_SECRET_WORD_2=
FREEKASSA_API_BASE=https://api.fk.life/v1

# Platega
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_BASE=https://app.platega.io
PLATEGA_PAYMENT_METHOD=

# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdttrc20

# Курс USD для конвертации (можно также в админке settings.usd_rate)
USD_RATE=90

# --- Telegram admin notify (как AdminTelegramNotifier) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

ENCRYPT_KEY=change-me-encrypt-key-32chars!!
